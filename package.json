{
  "name": "arena-model-archive",
  "private": true,
  "version": "0.1.0-p0",
  "description": "Arena Model Archive — Electron/Chromium + TypeScript, passive CDP first",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "npm run build && npm run dev --workspace=apps/desktop",
    "doctor": "tsx scripts/doctor.ts",
    "gate:p0": "tsx scripts/gate-p0.ts",
    "gate:p1": "tsx scripts/gate-p1.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:p0": "vitest run --config vitest.p0.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "electron": "^32.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2"
}
