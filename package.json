{
  "name": "arena-model-archive",
  "private": true,
  "version": "0.1.0",
  "description": "Arena Model Archive — Electron + TypeScript private archive with passive CDP capture",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "npm run build && electron apps/desktop/dist/main.js",
    "doctor": "tsx scripts/doctor.ts",
    "gate:p0": "tsx scripts/gate-p0.ts",
    "gate:p1": "tsx scripts/gate-p1.ts",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -b --verbose"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "electron": "^34.2.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.8"
}
