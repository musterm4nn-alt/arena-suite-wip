{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@arena/core": ["packages/core/src/index.ts"],
      "@arena/core/*": ["packages/core/src/*"],
      "@arena/schema": ["packages/schema/src/index.ts"],
      "@arena/schema/*": ["packages/schema/src/*"],
      "@arena/security": ["packages/security/src/index.ts"],
      "@arena/security/*": ["packages/security/src/*"],
      "@arena/capture-core": ["packages/capture-core/src/index.ts"],
      "@arena/capture-core/*": ["packages/capture-core/src/*"],
      "@arena/browser-adapter": ["packages/browser-adapter/src/index.ts"],
      "@arena/browser-adapter/*": ["packages/browser-adapter/src/*"],
      "@arena/protocol-catalog": ["packages/protocol-catalog/src/index.ts"],
      "@arena/protocol-catalog/*": ["packages/protocol-catalog/src/*"],
      "@arena/artifacts": ["packages/artifacts/src/index.ts"],
      "@arena/artifacts/*": ["packages/artifacts/src/*"],
      "@arena/archive-service": ["packages/archive-service/src/index.ts"],
      "@arena/archive-service/*": ["packages/archive-service/src/*"],
      "@arena/sync": ["packages/sync/src/index.ts"],
      "@arena/sync/*": ["packages/sync/src/*"],
      "@arena/mcp-contract": ["packages/mcp-contract/src/index.ts"],
      "@arena/mcp-contract/*": ["packages/mcp-contract/src/*"],
      "@arena/fixtures": ["packages/fixtures/src/index.ts"],
      "@arena/fixtures/*": ["packages/fixtures/src/*"],
      "@arena/analysis": ["packages/analysis/src/index.ts"],
      "@arena/analysis/*": ["packages/analysis/src/*"]
    }
  }
}
